
# =====================================
# CollabAI - Git Ignore
# =====================================

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
**/build/
coverage/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
*.tsbuildinfo

# Testing
.nyc_output/
playwright-report/
test-results/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor files
.vscode/
.idea/
*.suo
*.user
*.swp

# Temporary files
.tmp/
temp/
tmp/
*.bak
*.old

# Database files and backups
*.sqlite
*.sqlite3
*.db
*.sql.bak
*.dump

# Uploaded user files
uploads/
storage/uploads/

# Deployment
.vercel/
.netlify/

# Local certificates
*.pem
*.key
*.crt

# Python (if used for scripts)
__pycache__/
*.py[cod]
venv/
.envrc
